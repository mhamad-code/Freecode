# Public values only. Vite exposes every VITE_* variable to the browser bundle.
# Never put a secret here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# OAuth Web client id for Google Identity Services (auth bridge page)
VITE_GOOGLE_CLIENT_ID=

# Optional WebContainers commercial licence client id
VITE_WEBCONTAINER_CLIENT_ID=

# Optional default git CORS proxy (your own deployment only)
VITE_GIT_CORS_PROXY_URL=

# Optional links
VITE_COMMUNITY_URL=
VITE_REPO_URL=
